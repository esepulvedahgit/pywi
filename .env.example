# ─────────────────────────────────────────────────────────────────
# PyWI — Python Web IDE · Variables de entorno
# Copia este archivo a .env y rellena los valores
# ─────────────────────────────────────────────────────────────────

# REQUIRED — Name used by the local build: docker build -t pywi:local .
IMAGE_NAME=pywi:local

# REQUIRED — Public URL seen by browsers. Use https:// when Sophos terminates TLS.
APP_URL=http://localhost:3000

# Host interface that accepts connections to PyWI. For a separate Sophos proxy,
# set the host's private DMZ IP and allow port 3000 only from Sophos in the firewall.
PYWI_BIND_IP=127.0.0.1

# REQUIRED — AES-256-GCM key for encrypting AI API keys at rest (64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this after users have saved AI configs will invalidate their keys.
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_HERE

# OPTIONAL — Comma-separated socket IPs of trusted reverse proxies (Sophos or local proxy).
# Leave empty if clients connect directly. Never use a subnet or a wildcard.
TRUSTED_PROXY_IPS=

# OPTIONAL — Custom AI API base URLs allowed by an administrator, comma-separated.
# Example for Ollama in the same Docker network:
# AI_ALLOWED_BASE_URLS=http://ollama:11434/v1
# Keep this list under administrator control.
AI_ALLOWED_BASE_URLS=

# OPTIONAL — Python execution timeout in milliseconds (default: 3 minutes)
# EXEC_TIMEOUT_MS=180000

# OPTIONAL — Idle timeout for interactive input() sessions in milliseconds (default: 10 minutes)
# INPUT_IDLE_TIMEOUT_MS=600000
