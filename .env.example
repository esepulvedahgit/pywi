# ─────────────────────────────────────────────────────────────────
# PyWI — Python Web IDE · Variables de entorno
# Copia este archivo a .env y rellena los valores
# ─────────────────────────────────────────────────────────────────

# REQUIRED — Nombre e imagen Docker a usar según arquitectura del host
# amd64: IMAGE_NAME=python-web-ide:amd64
# arm64: IMAGE_NAME=python-web-ide:arm64
IMAGE_NAME=python-web-ide:arm64

# REQUIRED — Public URL of the application
APP_URL=http://localhost:3000

# REQUIRED — JWT secret for signing session tokens
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET

# REQUIRED — AES-256-GCM key for encrypting AI API keys at rest (64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this after users have saved AI configs will invalidate their keys.
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_HERE

# OPTIONAL — Python execution timeout in milliseconds (default: 3 minutes)
# EXEC_TIMEOUT_MS=180000

# OPTIONAL — Idle timeout for interactive input() sessions in milliseconds (default: 10 minutes)
# INPUT_IDLE_TIMEOUT_MS=600000
